# Copy to .env at the checkout root. Fill in all five literal, unquoted mirror locations; secrets go in files.
COMPOSE_FILE=deploy/docker-compose.yml:deploy/docker-compose.site.yml:deploy/docker-compose.source.yml:deploy/docker-compose.mirror.yml
# Fully qualified registry and optional repository prefix, e.g. artifacts.example.invalid/dockerhub/library
# Use a literal, unquoted value with no scheme or trailing slash. docker login uses the registry host.
MIRROR_DOCKER=
# PEP 503 simple index, e.g. https://artifacts.example.invalid/python/simple
MIRROR_PYPI=
# npm registry root, e.g. https://artifacts.example.invalid/npm
MIRROR_NPM=
# Debian archive root serving dists/trixie and dists/trixie-updates
MIRROR_DEBIAN=
# Debian security archive root serving dists/trixie-security
MIRROR_DEBIAN_SECURITY=
# Optional: pin the PostgreSQL 16 image, e.g. 16-alpine@sha256:<approved digest>.
# MIRROR_POSTGRES_TAG=16-alpine
# Optional absolute paths on the Docker client host. Use files outside the checkout for secrets.
# MIRROR_CA_FILE=                PEM CA bundle for package clients; Docker must also trust the registry
# MIRROR_NETRC_FILE=             netrc for the PyPI host
# MIRROR_NPMRC_FILE=             npm token scoped to a mirror registry host and path
# MIRROR_APT_AUTH_FILE=          APT auth.conf for the Debian mirror(s)
